# Yahoo OAuth (client ID and secret are required before running setup_yahoo_auth.py)
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_ACCESS_TOKEN=
YAHOO_REFRESH_TOKEN=
YAHOO_GUID=
YAHOO_REDIRECT_URI=oob
YAHOO_CALLBACK_PORT=8090
YAHOO_CALLBACK_HOST=localhost

# FastMCP HTTP transport (not used by the Claude Code stdio entrypoint)
HOST=0.0.0.0
PORT=8000

# Optional Reddit sentiment integration
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=

# Cache and Yahoo API limits
CACHE_DIR=./.cache
CACHE_TTL_SECONDS=3600
YAHOO_API_RATE_LIMIT=100
YAHOO_API_RATE_WINDOW_SECONDS=3600
SLEEPER_DEBUG=

# Logging and MCP metadata
LOG_LEVEL=INFO
LOG_FILE=./logs/yahoo_fantasy_football.log
MCP_SERVER_NAME=yahoo-fantasy-football
MCP_SERVER_VERSION=1.0.0

# Server and optimizer concurrency
MAX_WORKERS=10
ASYNC_TIMEOUT_SECONDS=30
OPTIMIZATION_MAX_WORKERS=4

# Optional optimizer LLM
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=30

# Optimizer behavior
USE_GENETIC_ALGORITHM=true
GENETIC_POPULATION_SIZE=1000
GENETIC_GENERATIONS=200
ENABLE_EXPLANATIONS=true
ENABLE_ALTERNATIVES=true
ENABLE_EDGE_CASES=true
ENABLE_CACHING=true
CACHE_SIZE_MB=100
ENABLE_METRICS=true
ENABLE_FILE_LOGGING=false
LOG_FILE_PATH=fantasy_optimizer.log
ENABLE_LLM_ENHANCEMENT=true
ENABLE_HYBRID_MODE=true
ENABLE_FALLBACK_MODE=true
ENVIRONMENT=development
MAX_OPTIMIZATIONS_PER_MINUTE=10
MAX_INTERACTIONS_PER_MINUTE=30

# Feature flags
ENABLE_ADVANCED_STATS=true
ENABLE_WEATHER_DATA=true
ENABLE_INJURY_REPORTS=true
